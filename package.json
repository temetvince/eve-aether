{
  "name": "aether-fleet-ops",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "npm run lint && npm run format && npm run docs && npm run typecheck && webpack --mode production",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix --fix-suggestions",
    "format": "prettier --write \"**/*.{cjs,mjs,js,jsx,ts,tsx,mts,cts,json,html,css,md}\"",
    "docs": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\"",
    "typecheck": "tsc --noEmit",
    "update": "ncu -u --peer"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "7.x",
    "@babel/preset-env": "7.x",
    "@babel/preset-react": "7.x",
    "@babel/preset-typescript": "7.x",
    "@types/react": "19.x",
    "@types/react-dom": "19.x",
    "babel-loader": "10.x",
    "copy-webpack-plugin": "14.x",
    "css-loader": "7.x",
    "html-webpack-plugin": "5.x",
    "markdownlint-cli2": "0.23.x",
    "npm-check-updates": "23.x",
    "oxlint": "1.x",
    "oxlint-tsgolint": "7.x",
    "prettier": "3.x",
    "style-loader": "4.x",
    "typescript": "7.x",
    "webpack": "5.x",
    "webpack-cli": "6.x",
    "webpack-dev-server": "5.x"
  },
  "dependencies": {
    "react": "19.x",
    "react-dom": "19.x"
  }
}
